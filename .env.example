# Neon connection string (dev branch). Get it from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/cla-trezo?sslmode=verify-full"

# CLA SSO
CLA_AUTH_HOST="https://TODO-host-sso-cla"
CLA_AUTH_IDENTIFIER="TODO-identifiant-app-cla"

# Secret used to encrypt the session cookie (min. 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="TODO-generer-un-secret-aleatoire-32-caracteres-minimum"

# Bypass local du SSO pour les tests visuels et les agents. Il est ignoré
# quand NODE_ENV=production. DEV_AUTH_USERNAME est facultatif : sans lui, une
# identité Admin synthétique ayant accès à toutes les assos permet les parcours
# de lecture ; avec lui, la même portée utilise l'identité d'un utilisateur
# existant pour les écritures.
DEV_AUTH_BYPASS="false"
# DEV_AUTH_USERNAME="username-cla-existant"

# Dossier racine où sont stockés les fichiers uploadés (Justificatifs, PDF
# générés...). Chemin absolu recommandé en production (ex: un point de
# montage dédié sur le serveur CLA) ; chemin relatif au process en dev.
STORAGE_ROOT_DIR="./uploads"

# Garde-fou pour les scripts de seed manuels sous scripts/ (cf.
# docs/agents/seeds.md). Doit valoir "true" pour les autoriser à écrire
# dans la base — à ne JAMAIS définir dans un environnement de production.
ALLOW_DEV_SEED="true"
