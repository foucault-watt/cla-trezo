generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AssoType {
  CLUB
  COMMISSION
  ASSOCIATION_1901
}

enum AssoStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ExpenseReportStatus {
  DRAFT
  SUBMITTED
  TAKEN_OVER
  FINALIZED
  REJECTED
}

enum FundingSourceType {
  CLUB_BALANCE
  SUBVENTION
}

enum SupportingDocumentType {
  RECEIPT
  HONOR_STATEMENT
}

enum FinancialMovementType {
  CREDIT
  DEBIT
}

enum FinancialAccountType {
  CLUB_BALANCE
  SUBVENTION
}

enum FinancialMovementOrigin {
  MANUAL
  EXPENSE_REPORT
}

enum SubventionType {
  CA_BUDGET
  CA_EVENT
  CA_EXCEPTIONNEL
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @unique
  firstname String
  lastname  String
  isAdmin   Boolean  @default(false)
  group     String?
  createdAt DateTime @default(now()) @map("created_at")

  memberships               RefAssoUser[]
  logs                      UserLog[]
  createdExpenseReports     ExpenseReport[]     @relation("CreatedBy")
  takenExpenseReports       ExpenseReport[]     @relation("TakenByAdmin")
  createdFinancialMovements FinancialMovement[]

  @@map("user")
}

model Asso {
  id        String     @id @default(uuid()) @db.Uuid
  slug      String     @unique
  name      String
  status    AssoStatus
  type      AssoType
  createdAt DateTime   @default(now()) @map("created_at")

  memberships        RefAssoUser[]
  expenseReports     ExpenseReport[]
  subventions        Subvention[]
  financialMovements FinancialMovement[]

  @@map("asso")
}

model RefAssoUser {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  assoId    String    @map("asso_id") @db.Uuid
  role      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  endedAt   DateTime? @map("ended_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  asso Asso @relation(fields: [assoId], references: [id], onDelete: Cascade)

  @@map("ref_asso_user")
}

model UserLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  connectedAt DateTime @default(now()) @map("connected_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_log")
}

model SubventionCampaign {
  id              String         @id @default(uuid()) @db.Uuid
  type            SubventionType
  name            String
  date            DateTime       @db.Date
  publicationDate DateTime?      @map("publication_date")
  createdAt       DateTime       @default(now()) @map("created_at")

  subventions Subvention[]

  @@map("subvention_campaign")
}

model Subvention {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  assoId      String   @map("asso_id") @db.Uuid
  reason      String
  amountCents Int      @map("amount_cents")
  commentary  String?
  createdAt   DateTime @default(now()) @map("created_at")

  campaign           SubventionCampaign  @relation(fields: [campaignId], references: [id])
  asso               Asso                @relation(fields: [assoId], references: [id])
  expenseReportLines ExpenseReportLine[]
  financialMovements FinancialMovement[]

  @@map("subvention")
}

model ExpenseReport {
  id             String              @id @default(uuid()) @db.Uuid
  assoId         String              @map("asso_id") @db.Uuid
  createdBy      String              @map("created_by") @db.Uuid
  title          String
  description    String?
  status         ExpenseReportStatus @default(DRAFT)
  takenByAdminId String?             @map("taken_by_admin_id") @db.Uuid
  takenAt        DateTime?           @map("taken_at")
  submittedAt    DateTime?           @map("submitted_at")
  finalizedAt    DateTime?           @map("finalized_at")
  finalPdfPath   String?             @map("final_pdf_path")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  asso                Asso                 @relation(fields: [assoId], references: [id])
  creator             User                 @relation("CreatedBy", fields: [createdBy], references: [id])
  takenByAdmin        User?                @relation("TakenByAdmin", fields: [takenByAdminId], references: [id])
  lines               ExpenseReportLine[]
  supportingDocuments SupportingDocument[]

  @@map("expense_report")
}

model TypeDepense {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  expenseReportLines ExpenseReportLine[]

  @@map("type_depense")
}

model ExpenseReportLine {
  id                   String            @id @default(uuid()) @db.Uuid
  expenseReportId      String            @map("expense_report_id") @db.Uuid
  beneficiaryFirstname String            @map("beneficiary_firstname")
  beneficiaryLastname  String            @map("beneficiary_lastname")
  iban                 String?
  amountCents          Int               @map("amount_cents")
  typeDepenseId        String?           @map("type_depense_id") @db.Uuid
  customLabel          String?           @map("custom_label")
  fundingSource        FundingSourceType @map("funding_source")
  subventionId         String?           @map("subvention_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  expenseReport     ExpenseReport      @relation(fields: [expenseReportId], references: [id])
  typeDepense       TypeDepense?       @relation(fields: [typeDepenseId], references: [id])
  subvention        Subvention?        @relation(fields: [subventionId], references: [id])
  financialMovement FinancialMovement?

  @@map("expense_report_line")
}

model SupportingDocument {
  id               String                 @id @default(uuid()) @db.Uuid
  expenseReportId  String                 @map("expense_report_id") @db.Uuid
  type             SupportingDocumentType
  filePath         String                 @map("file_path")
  originalFilename String                 @map("original_filename")
  mimeType         String                 @map("mime_type")
  createdAt        DateTime               @default(now()) @map("created_at")

  expenseReport ExpenseReport @relation(fields: [expenseReportId], references: [id])

  @@map("supporting_document")
}

model FinancialMovement {
  id           String                  @id @default(uuid()) @db.Uuid
  assoId       String                  @map("asso_id") @db.Uuid
  movementType FinancialMovementType   @map("movement_type")
  accountType  FinancialAccountType    @map("account_type")
  origin       FinancialMovementOrigin
  amountCents  Int                     @map("amount_cents")

  subventionId        String? @map("subvention_id") @db.Uuid
  expenseReportLineId String? @unique @map("expense_report_line_id") @db.Uuid
  createdBy           String  @map("created_by") @db.Uuid

  category    String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  asso              Asso               @relation(fields: [assoId], references: [id])
  subvention        Subvention?        @relation(fields: [subventionId], references: [id])
  expenseReportLine ExpenseReportLine? @relation(fields: [expenseReportLineId], references: [id])
  creator           User               @relation(fields: [createdBy], references: [id])

  @@map("financial_movement")
}

