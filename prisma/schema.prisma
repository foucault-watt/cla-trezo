// // ─────────────────────────────────────────────
// // JOURNAL FINANCIER
// // ─────────────────────────────────────────────

// Table financial_movement {
//   id uuid [primary key]
//   asso_id uuid [not null]
//   created_by uuid [not null]

//   movement_type financial_movement_type [not null]
//   account_type financial_account_type [not null]
//   origin financial_movement_origin [not null]
//   amount_cents int [not null]

//   subvention_id uuid
//   expense_report_line_id uuid [unique]

//   category varchar
//   description varchar

//   created_at timestamp [not null, default: `now()`]

//   // account_type = CLUB_BALANCE  => subvention_id doit être null, asso doit être un Club
//   // account_type = SUBVENTION    => subvention_id est obligatoire
//   // origin = MANUAL              => expense_report_line_id doit être null
//   // origin = EXPENSE_REPORT      => expense_report_line_id est obligatoire, created_by = admin qui finalise
//   // amount_cents >= 0, le sens est donné uniquement par movement_type
//   // généré uniquement au passage d'une note de frais en FINALIZED, un mouvement par ligne, immuable
//   //
//   // Cohérence avec la expense_report_line d'origine (contrôlée en service métier,
//   // à terme en contrainte SQL) :
//   //   financial_movement.amount_cents  = expense_report_line.amount_cents
//   //   financial_movement.account_type  = expense_report_line.funding_source
//   //   financial_movement.subvention_id = expense_report_line.subvention_id
// }

