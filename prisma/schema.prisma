generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AssoType {
  CLUB
  COMMISSION
  ASSOCIATION_1901
}

enum AssoStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ExpenseReportStatus {
  DRAFT
  SUBMITTED
  TAKEN_OVER
  FINALIZED
}

enum FundingSourceType {
  CLUB_BALANCE
  SUBVENTION
}

enum SupportingDocumentType {
  RECEIPT
  HONOR_STATEMENT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @unique
  firstname String
  lastname  String
  isAdmin   Boolean  @default(false)
  group     String?
  createdAt DateTime @map("created_at")

  memberships          RefAssoUser[]
  logs                 UserLog[]
  createdExpenseReports ExpenseReport[] @relation("CreatedBy")
  takenExpenseReports   ExpenseReport[] @relation("TakenByAdmin")

  @@map("user")
}

model Asso {
  id        String     @id @default(uuid()) @db.Uuid
  slug      String     @unique
  name      String
  status    AssoStatus
  type      AssoType
  createdAt DateTime   @map("created_at")

  memberships    RefAssoUser[]
  expenseReports ExpenseReport[]
  subventions    SubventionAsso[]

  @@map("asso")
}

model RefAssoUser {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  assoId   String  @map("asso_id") @db.Uuid
  role     String
  isActive Boolean @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  asso Asso @relation(fields: [assoId], references: [id], onDelete: Cascade)

  @@unique([userId, assoId])
  @@map("ref_asso_user")
}

model UserLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  connectedAt DateTime @map("connected_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_log")
}

model Subvention {
  id   String   @id @default(uuid()) @db.Uuid
  type String
  name String
  date DateTime @db.Date

  assos SubventionAsso[]

  @@map("subvention")
}

model SubventionAsso {
  id           String  @id @default(uuid()) @db.Uuid
  subventionId String  @map("subvention_id") @db.Uuid
  assoId       String  @map("asso_id") @db.Uuid
  commentary   String?

  subvention         Subvention          @relation(fields: [subventionId], references: [id])
  asso               Asso                @relation(fields: [assoId], references: [id])
  lines              SubventionAssoLine[]
  expenseReportLines ExpenseReportLine[]

  @@map("subvention_asso")
}

model SubventionAssoLine {
  id               String @id @default(uuid()) @db.Uuid
  subventionAssoId String @map("subvention_asso_id") @db.Uuid
  amount           Int
  reason           String

  subventionAsso SubventionAsso @relation(fields: [subventionAssoId], references: [id])

  @@map("subvention_asso_line")
}

model ExpenseReport {
  id             String              @id @default(uuid()) @db.Uuid
  assoId         String              @map("asso_id") @db.Uuid
  createdBy      String              @map("created_by") @db.Uuid
  title          String
  description    String?
  status         ExpenseReportStatus
  takenByAdminId String?             @map("taken_by_admin_id") @db.Uuid
  takenAt        DateTime?           @map("taken_at")
  submittedAt    DateTime?           @map("submitted_at")
  finalizedAt    DateTime?           @map("finalized_at")
  finalPdfPath   String?             @map("final_pdf_path")
  createdAt      DateTime            @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  asso               Asso               @relation(fields: [assoId], references: [id])
  creator            User               @relation("CreatedBy", fields: [createdBy], references: [id])
  takenByAdmin       User?              @relation("TakenByAdmin", fields: [takenByAdminId], references: [id])
  lines              ExpenseReportLine[]
  supportingDocuments SupportingDocument[]

  @@map("expense_report")
}

model ExpenseReportLine {
  id                   String            @id @default(uuid()) @db.Uuid
  expenseReportId      String            @map("expense_report_id") @db.Uuid
  beneficiaryFirstname String            @map("beneficiary_firstname")
  beneficiaryLastname  String            @map("beneficiary_lastname")
  iban                 String?
  amount               Int
  category             String
  fundingSource        FundingSourceType @map("funding_source")
  subventionAssoId     String?           @map("subvention_asso_id") @db.Uuid
  createdAt            DateTime          @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  expenseReport  ExpenseReport   @relation(fields: [expenseReportId], references: [id])
  subventionAsso SubventionAsso? @relation(fields: [subventionAssoId], references: [id])

  @@map("expense_report_line")
}

model SupportingDocument {
  id               String                 @id @default(uuid()) @db.Uuid
  expenseReportId  String                 @map("expense_report_id") @db.Uuid
  type             SupportingDocumentType
  filePath         String                 @map("file_path")
  originalFilename String                 @map("original_filename")
  mimeType         String                 @map("mime_type")
  createdAt        DateTime               @map("created_at")

  expenseReport ExpenseReport @relation(fields: [expenseReportId], references: [id])

  @@map("supporting_document")
}
